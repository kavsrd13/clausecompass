{
  "name": "airwise-urban-air-quality",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=\"api/*.js\" --test-coverage-include=\"lib/*.js\" --test-coverage-include=\"lib/server/*.js\" --test-coverage-include=\"lib/client/*.js\" --test-coverage-lines=98 --test-coverage-branches=98 --test-coverage-functions=98 --test tests/*.test.js",
    "test:browser": "playwright test",
    "format:check": "prettier --check main.js style.css index.html api lib tests scripts types *.json *.config.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "axe-core": "4.14.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
