{
  "name": "clausecompass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "format:check": "prettier --check main.js style.css index.html api lib tests scripts *.json eslint.config.js",
    "lint": "eslint .",
    "typecheck": "tsc",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "vite": "8.3.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
