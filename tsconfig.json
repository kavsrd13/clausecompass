{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "api/**/*.js",
    "lib/contracts.js",
    "lib/limits.js",
    "lib/server/**/*.js",
    "lib/client/export.js",
    "lib/air.js"
  ]
}
